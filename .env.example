# Vercel AI Gateway — required. Create a key at:
# https://vercel.com/d?to=%2Fai-gateway%2Fapi-keys
AI_GATEWAY_API_KEY=

# Gateway model id for Jev (evaluation, not chat).
JEV_MODEL=typesafe-ai/jev

# Optional: pin zero data retention on Gateway requests.
# JEV_ZERO_DATA_RETENTION=true

# Optional. Used only when fast_web_task fillMode is "helper".
# Default is bot: Grok Bot writes TYPE_TEXT via fast_web_fill.
JEV_TEXT_MODEL=google/gemini-2.5-flash

# Playwright Chromium is launched unless you point at an existing Chrome:
# CDP_URL=http://127.0.0.1:9222
# JEV_HEADLESS=true
