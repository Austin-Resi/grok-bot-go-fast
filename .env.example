# Vercel AI Gateway — required. Create a key at:
# https://vercel.com/d?to=%2Fai-gateway%2Fapi-keys
AI_GATEWAY_API_KEY=

# All crack-bot settings use the CRACK_BOT_ prefix. Legacy JEV_ names still work.

# Gateway model id for the decision model (evaluation, not chat).
CRACK_BOT_MODEL=typesafe-ai/jev

# Optional: pin zero data retention on Gateway requests.
# CRACK_BOT_ZERO_DATA_RETENTION=true

# Optional. Used only when fast_web_task fillMode is "helper".
# Default is bot: Grok Bot writes TYPE_TEXT via fast_web_fill.
CRACK_BOT_TEXT_MODEL=google/gemini-2.5-flash

# Attach to this agent's Chrome (shared cookies/logins). Leave CDP_URL unset:
# crack-bot finds Chromes on this DISPLAY (Linux: /proc/<pid>/environ), reads
# their <profile>/DevToolsActivePort (written by Chrome 144+'s
# chrome://inspect/#remote-debugging toggle or --remote-debugging-port) and
# connects to that ws:// endpoint. If no Chrome on this DISPLAY exposes
# DevTools it launches its own headed Chromium here; it never attaches to a
# Chrome on another display.
# CRACK_BOT_CDP_PROFILE_DIR=/home/bot/chrome-profile-14   # pin one profile
# CRACK_BOT_CDP_DISPLAY=:14                                # scope to a display other than $DISPLAY
# CDP_URL=ws://127.0.0.1:9222/devtools/browser/<id>        # pin the endpoint (ws://, not http://)
# CRACK_BOT_CDP_DISCOVER=false                             # always launch own Chromium
# CRACK_BOT_HEADLESS=true

# Wall-clock budget per fast_web_task / fast_web_fill call. Returns "budget"
# with the tab open when exceeded; stay under the MCP client's timeout.
# CRACK_BOT_MAX_RUN_MS=45000

# Multi-step goals. Offscreen links/buttons ranked against the goal are offered
# to Jev alongside the viewport (0 disables); choosing one scrolls to it first.
# Jev acts alone when its top pick leads the runner-up by at least ASK_MARGIN;
# otherwise (or on BLOCKED) the run returns need_decision for the Bot to choose.
# After NO_PROGRESS_LIMIT consecutive steps that change nothing it also asks.
# CRACK_BOT_PLAN_TOP_K=32
# CRACK_BOT_ASK_MARGIN=0.2
# CRACK_BOT_NO_PROGRESS_LIMIT=3
