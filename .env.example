# Vercel AI Gateway — required. Create a key at:
# https://vercel.com/d?to=%2Fai-gateway%2Fapi-keys
AI_GATEWAY_API_KEY=

# Gateway model id for Jev (evaluation, not chat).
JEV_MODEL=typesafe-ai/jev

# Optional: pin zero data retention on Gateway requests.
# JEV_ZERO_DATA_RETENTION=true

# Optional. Used only when fast_web_task fillMode is "helper".
# Default is bot: Grok Bot writes TYPE_TEXT via fast_web_fill.
JEV_TEXT_MODEL=google/gemini-2.5-flash

# Attach to this agent's Chrome (shared cookies/logins). Leave CDP_URL unset:
# Jev finds Chromes on this DISPLAY (Linux: /proc/<pid>/environ), reads their
# <profile>/DevToolsActivePort (written by Chrome 144+'s
# chrome://inspect/#remote-debugging toggle or --remote-debugging-port) and
# connects to that ws:// endpoint. If no Chrome on this DISPLAY exposes
# DevTools it launches its own headed Chromium here; it never attaches to a
# Chrome on another display.
# JEV_CDP_PROFILE_DIR=/home/bot/chrome-profile-14   # pin one profile
# JEV_CDP_DISPLAY=:14                                # scope to a display other than $DISPLAY
# CDP_URL=ws://127.0.0.1:9222/devtools/browser/<id>  # pin the endpoint (ws://, not http://)
# JEV_CDP_DISCOVER=false                             # always launch own Chromium
# JEV_HEADLESS=true

# Wall-clock budget per fast_web_task / fast_web_fill call. Returns "budget"
# with the tab open when exceeded; stay under the MCP client's timeout.
# JEV_MAX_RUN_MS=45000
