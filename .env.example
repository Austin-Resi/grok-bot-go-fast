# Vercel AI Gateway — required. Create a key at:
# https://vercel.com/d?to=%2Fai-gateway%2Fapi-keys
AI_GATEWAY_API_KEY=

# Gateway model id for Jev (evaluation, not chat).
JEV_MODEL=typesafe-ai/jev

# Optional: pin zero data retention on Gateway requests.
# JEV_ZERO_DATA_RETENTION=true

# Optional. Used only when fast_web_task fillMode is "helper".
# Default is bot: Grok Bot writes TYPE_TEXT via fast_web_fill.
JEV_TEXT_MODEL=google/gemini-2.5-flash

# Attach to the Bot's Chrome (shared cookies/logins). Leave CDP_URL unset:
# Jev reads <profile>/DevToolsActivePort (written by Chrome 144+'s
# chrome://inspect/#remote-debugging toggle or --remote-debugging-port) and
# connects to that ws:// endpoint. Falls back to http://127.0.0.1:9222, then
# to launching its own Chromium.
# To pin it, use the ws:// URL from DevToolsActivePort, not http://.
# CDP_URL=ws://127.0.0.1:9222/devtools/browser/<id>
# JEV_CDP_DISCOVER=false
# JEV_HEADLESS=true
